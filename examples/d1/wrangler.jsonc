{
  "name": "f4y-example",
  "main": ".topcoat-cloudflare/dist/entry.ts",
  "build": {
    "command": "npx --no-install topcoat-cloudflare build",
    "cwd": ".",
    "watch_dir": [
      "src",
      "assets",
      "public",
      "Cargo.toml",
      "Cargo.lock",
      "build.rs",
      "styles.css",
      "components.toml",
      "rust-toolchain.toml",
    ],
  },
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["enable_request_signal"],
  "assets": {
    "directory": ".topcoat-cloudflare/dist/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_topcoat/assets/*"],
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "f4y-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
