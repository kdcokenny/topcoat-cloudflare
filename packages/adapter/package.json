{
  "name": "@topcoat-cloudflare/adapter",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "topcoat-cloudflare": "dist/bin/adapter.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.0"
  },
  "description": "Build and deploy Topcoat applications on Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdcokenny/topcoat-cloudflare.git",
    "directory": "packages/adapter"
  },
  "files": [
